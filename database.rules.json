{
  "rules": {
    ".read": false,
    ".write": false,
    "collection": {
      ".read": "auth != null && (auth.uid === 'REPLACE_YOUR_UID' || auth.uid === 'REPLACE_BOYFRIEND_UID')",
      ".write": "auth != null && (auth.uid === 'REPLACE_YOUR_UID' || auth.uid === 'REPLACE_BOYFRIEND_UID') && newData.exists()",
      ".validate": "newData.child('initialized').val() === true",
      "initialized": {
        ".validate": "newData.val() === true"
      },
      "items": {
        "$item": {
          ".validate": "newData.val() === true && $item.matches(/^[a-z0-9_]+$/)"
        },
        ".validate": "newData.hasChildren()"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
